APP_NAME="GameHub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gamehub
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@gamehub.local"
MAIL_FROM_NAME="${APP_NAME}"

GAME_SANDBOX_DOMAIN=
GAME_MAX_ZIP_SIZE_MB=50
GAME_MAX_EXTRACTED_SIZE_MB=150
GAME_MAX_FILE_COUNT=500

SEED_SUPER_ADMIN_EMAIL="admin@gamehub.local"
SEED_SUPER_ADMIN_PASSWORD="GameHubLocal2026!"
SEED_ADMIN_EMAIL="moderator@gamehub.local"
SEED_ADMIN_PASSWORD="GameHubAdmin2026!"
SEED_USER_EMAIL="player@gamehub.local"
SEED_USER_PASSWORD="GameHubPlayer2026!"

VITE_APP_NAME="${APP_NAME}"
