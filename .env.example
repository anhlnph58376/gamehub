APP_NAME="GameHub"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gamehub
DB_USERNAME=gamehub_user
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Khuyến nghị cấu hình subdomain riêng cho Iframe Sandbox trên môi trường Production
GAME_SANDBOX_DOMAIN=
GAME_MAX_ZIP_SIZE_MB=50
GAME_MAX_EXTRACTED_SIZE_MB=150
GAME_MAX_FILE_COUNT=500

# Thông tin khởi tạo tài khoản Seeder (Để trống mật khẩu trên Git; nếu để trống khi seed hệ thống sẽ sinh mật khẩu ngẫu nhiên)
SEED_SUPER_ADMIN_EMAIL="admin@gamehub.local"
SEED_SUPER_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL="moderator@gamehub.local"
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL="player@gamehub.local"
SEED_USER_PASSWORD=

# Cấu hình OAuth 2.0 Đăng nhập bằng Google (Gmail) & Facebook
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

VITE_APP_NAME="${APP_NAME}"
